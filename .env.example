# URL canonico del sito (SEO, sitemap, schema.org)
# VITE_SITE_URL=https://www.rtalevele.com

# Google Analytics 4 — caricato SOLO con consenso "analytics" (runtime injection)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel — caricato SOLO con consenso "marketing" (runtime injection)
# VITE_META_PIXEL_ID=123456789

# Resend — invio richieste prenotazione (solo server / Vercel, NON prefissare con VITE_)
# Crea la chiave su https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# Destinatario delle richieste (default: info@rtalevele.com)
# BOOKING_TO_EMAIL=info@rtalevele.com
# Mittente — dopo verifica dominio su Resend, es.:
# BOOKING_FROM_EMAIL=Residence Le Vele <prenotazioni@rtalevele.com>
# In test senza dominio verificato usa:
# BOOKING_FROM_EMAIL=Residence Le Vele <onboarding@resend.dev>

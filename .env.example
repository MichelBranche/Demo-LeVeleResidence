# URL canonico del sito (SEO, sitemap, anteprima link WhatsApp/Facebook, schema.org)
# In produzione: https://www.rtalevele.com
# Su Vercel senza dominio custom: https://TUO-PROGETTO.vercel.app
# VITE_SITE_URL=https://www.rtalevele.com

# Slope — booking engine (gestionale)
# ID struttura dal backoffice Slope / widget WordPress (default: Le Vele)
# VITE_SLOPE_PROPERTY_ID=2e5ba507-0d51-4d20-95e2-899fdb2d8aae
# Base URL booking engine (default: https://booking.slope.it)
# VITE_SLOPE_BOOKING_BASE_URL=https://booking.slope.it
# Imposta a false per usare il form email al posto di Slope
# VITE_SLOPE_BOOKING_ENABLED=false

# Google Analytics 4 — caricato SOLO con consenso "analytics" (runtime injection)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel — caricato SOLO con consenso "marketing" (runtime injection)
# VITE_META_PIXEL_ID=123456789

# Mux — video hero HLS (playback ID dalla dashboard Mux)
# VITE_MUX_HERO_PLAYBACK_ID=LowyOggTofZ1rqZxKkT4mdeUHTzdW007W61UaghsNf01c

# Resend — invio richieste prenotazione (solo server / Vercel, NON prefissare con VITE_)
# Crea la chiave su https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# Destinatario delle richieste (default: info@rtalevele.com)
# BOOKING_TO_EMAIL=info@rtalevele.com
# Mittente — dopo verifica dominio su Resend, es.:
# BOOKING_FROM_EMAIL=Residence Le Vele <prenotazioni@rtalevele.com>
# In test senza dominio verificato usa:
# BOOKING_FROM_EMAIL=Residence Le Vele <onboarding@resend.dev>
#
# IMPORTANTE (modalità test Resend): finché il dominio non è verificato,
# le email possono essere inviate SOLO all'indirizzo con cui ti sei registrato su Resend.
# Per produzione: verifica rtalevele.com su https://resend.com/domains
# poi usa BOOKING_TO_EMAIL=info@rtalevele.com e mittente @rtalevele.com
